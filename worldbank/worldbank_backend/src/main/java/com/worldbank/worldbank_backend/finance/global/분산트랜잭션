### 5. repo router

이게 핵심이다.

```java
import org.springframework.stereotype.Component;

import java.util.EnumMap;
import java.util.List;
import java.util.Map;

@Component
public class WalletRepositoryRouter {

    private final Map<DbType, WalletRepositoryPort> repositoryMap = new EnumMap<>(DbType.class);

    public WalletRepositoryRouter(List<WalletRepositoryPort> repositories) {
        for (WalletRepositoryPort repository : repositories) {
            repositoryMap.put(repository.supports(), repository);
        }
    }

    public WalletRepositoryPort route(DbType dbType) {
        WalletRepositoryPort repository = repositoryMap.get(dbType);
        if (repository == null) {
            throw new IllegalArgumentException("지원하지 않는 DB 타입: " + dbType);
        }
        return repository;
    }
}
```

