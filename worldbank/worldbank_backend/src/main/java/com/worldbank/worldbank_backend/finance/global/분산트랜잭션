```java
import org.springframework.stereotype.Repository;

import java.util.HashMap;
import java.util.Map;
import java.util.Optional;

@Repository
public class Db1WalletRepository implements WalletRepositoryPort {

    private final Map<Long, Wallet> store = new HashMap<>();

    @Override
    public DbType supports() {
        return DbType.DB1;
    }

    @Override
    public Optional<Wallet> findById(Long walletId) {
        return Optional.ofNullable(store.get(walletId));
    }

    @Override
    public Wallet save(Wallet wallet) {
        store.put(wallet.getId(), wallet);
        return wallet;
    }
}
```

DB2, DB3, DB4도 동일하게 만든다.

실무에서는 이 부분이 이렇게 바뀐다.

```java
@Repository
public class Db1WalletRepositoryAdapter implements WalletRepositoryPort {

    private final Db1JpaWalletRepository jpaRepository;

    public Db1WalletRepositoryAdapter(Db1JpaWalletRepository jpaRepository) {
        this.jpaRepository = jpaRepository;
    }

    @Override
    public DbType supports() {
        return DbType.DB1;
    }

    @Override
    public Optional<Wallet> findById(Long walletId) {
        return jpaRepository.findById(walletId).map(WalletEntity::toDomain);
    }

    @Override
    public Wallet save(Wallet wallet) {
        WalletEntity saved = jpaRepository.save(WalletEntity.from(wallet));
        return saved.toDomain();
    }
}
```

